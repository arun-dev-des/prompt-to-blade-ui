# Required only for the Level 2 "prompt → Blade" studio (the /api/generate function).
# Set this in Vercel: Project → Settings → Environment Variables → ANTHROPIC_API_KEY.
# Without it, Level 2 gracefully falls back to local keyword recipes.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — PostHog product analytics. This is a public/client-side key (like a
# GA measurement ID), safe to expose in the bundle. A default is hardcoded in
# src/analytics.ts, so these only matter if you're pointing a fork at your own
# PostHog project.
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com
